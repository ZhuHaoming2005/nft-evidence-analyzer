# Python collection settings. Rust commands use environment variables or CLI flags.
LOG_LEVEL=INFO

# Keep these three settings on the same chain.
CHAIN_NAME=base
RPC_URL=https://mainnet.base.org
ALCHEMY_NETWORK=base-mainnet

# Scan backward: END_BLOCK=0 selects the current tip; START_BLOCK=0 reaches genesis.
START_BLOCK=0
END_BLOCK=0
BLOCK_BATCH_SIZE=500
REQUEST_DELAY=0.2
SCAN_WINDOW=3
CONCURRENT_ALCHEMY=10
CONCURRENT_RPC=10
ALCHEMY_BATCH_SIZE=100
RPC_BATCH_SIZE=100
METADATA_TIMEOUT=10
METADATA_CONNECT_TIMEOUT=15

# Supply keys only for providers used by the chosen command.
ALCHEMY_API_KEY=
ETHERSCAN_API_KEY=
HELIUS_API_KEY=
OPENSEA_API_KEY=
NFTSCAN_API_KEY=

IPFS_GATEWAYS=https://gateway.pinata.cloud/ipfs,https://dweb.link/ipfs,https://ipfs.io/ipfs
PINATA_GATEWAY_TOKEN=

# Metadata worker claims. Timeout must exceed the slowest batch duration.
FETCH_IDLE_WAIT=30
FETCHER_WORKERS=2
FETCH_CLAIM_BATCH_SIZE=2000
CLAIM_RETRY_AFTER_SECONDS=600
WORKER_STARTUP_DELAY_SECONDS=3
WORKER_SHUTDOWN_GRACE_SECONDS=60
REQUEST_STARTUP_STAGGER_SECONDS=0.1

# Missing-image retries.
CONCURRENT_REQUESTS=20
RETRY_BATCH_SIZE=1000

# Comma-separated excluded contract addresses.
DEFI_BLACKLIST=

DB_HOST=localhost
DB_PORT=5432
DB_NAME=nft_data
DB_USER=postgres
DB_PASS=
DB_CONNECT_TIMEOUT=10

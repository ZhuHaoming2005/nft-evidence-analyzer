# Merge these settings into the repository-root .env for Solana collection.
CHAIN_NAME=solana
HELIUS_API_KEY=

# GPA pagination. Zero starts a full scan or resumes saved database progress.
# A newer database slot takes precedence over an older configured slot.
GPA_PAGE_SIZE=1000
GPA_SINCE_SLOT=0

CONCURRENT_HELIUS=10
HELIUS_BATCH_SIZE=1000
METADATA_TIMEOUT=30
METADATA_CONNECT_TIMEOUT=30
FETCH_IDLE_WAIT=600
FETCHER_WORKERS=3
FETCH_CLAIM_BATCH_SIZE=5000

# Claim timeout must exceed the slowest metadata-fetch and database-write batch.
CLAIM_RETRY_AFTER_SECONDS=1800
WORKER_STARTUP_DELAY_SECONDS=5
WORKER_SHUTDOWN_GRACE_SECONDS=60
REQUEST_STARTUP_STAGGER_SECONDS=5
DB_INSERT_PAGE_SIZE=1000

DB_HOST=localhost
DB_PORT=5432
DB_NAME=nft_data
DB_USER=postgres
DB_PASS=
